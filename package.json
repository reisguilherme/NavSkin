{
  "name": "navskin",
  "version": "0.7.1",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-docs.mjs && node scripts/export-styles.mjs",
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "build": "node scripts/copy-docs.mjs && node scripts/export-styles.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "node --test tests/*.test.mjs",
    "data:fetch": "node scripts/fetch-osm.mjs",
    "data:validate": "node scripts/validate-geodata.mjs",
    "pois:fetch": "node scripts/fetch-pois.mjs && node scripts/build-pois.mjs",
    "icons:build": "node scripts/build-poi-sprites.mjs",
    "buildings:tiles": "node scripts/tile-buildings.mjs",
    "buildings:validate-tiles": "node scripts/validate-building-tiles.mjs",
    "maps:world": "node scripts/prepare-world-maps.mjs",
    "ios:prepare": "node scripts/prepare-ios.mjs",
    "assets:game": "node scripts/prepare-game-assets.mjs"
  },
  "dependencies": {
    "maplibre-gl": "6.16.0"
  },
  "devDependencies": {
    "@mapbox/maki": "8.2.0",
    "geojson-vt": "4.0.2",
    "sharp": "0.34.5",
    "vite": "8.3.5",
    "vt-pbf": "3.1.3"
  }
}
