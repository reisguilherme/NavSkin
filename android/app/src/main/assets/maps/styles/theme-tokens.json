{
  "specification": {
    "gtaReference": "Calibrated against the user TO-BE screenshots (2026-10-27): gray urban fabric, off-white footprints, deep green parks, black roads, original game fonts/sprites from the separately supplied asset pack.",
    "rosaReference": "Original candy-pink Rosa Pop cartography: vivid mint parks, turquoise water, pink/lilac night fabric and cute original symbols.",
    "edit": "Edit palettes and android/maps/icons/{gta,rosa,rdr2,smw,minecraft,cyberpunk,gta5}/*.svg, then run node scripts/prepare-android-maps.mjs.",
    "rdr2Reference": "Parchment and ink cartography with imported game font families and matching original blips, plus explicitly authored adaptations for modern categories. See game-assets/provenance.json for exact origin and notices.",
    "smwReference": "Nintendo official SNES overworld: vivid green terraces, tan raised roof masses, blue tiled water, pale paths, dark silhouette borders and standalone colorful pixel sprites. Original geographic footprints retained.",
    "minecraftReference": "Minecraft filled-map/block material language: grass, wood, stone and pixelated blue water, earth paths, block-edged roof silhouettes and item sprites. Material tiles are decorative; real source coordinates retained.",
    "cyberpunkReference": "Cyberpunk 2077 map: near-black background, red building volumes/wireframe, cyan road edges, yellow/cyan/white standalone blips. Architectural line patterns and shadows are illustrative, not measured height.",
    "gta5Reference": "GTA V classic pause map: black/gray roads, muted gray urban masses, subdued parks/water and standalone white blips. Night switches to modern dark monochrome palette. Sources documented in docs/design.",
    "collectionReference": "Approved Pip-Boy, Hollow Knight and Crossy Road studies promoted in scripts/theme-art; art changes require regeneration, not palette replacement."
  },
